# ─────────────────────────────────────────────────────────────
# ⚠️  SECURITY WARNING — anything prefixed VITE_ is PUBLIC.
# Vite inlines these into the browser bundle, so they are visible
# to every visitor in DevTools. NEVER put a real secret (API key,
# password, connection string) in a VITE_ variable on a deployed
# build. For production, route AI calls through a server proxy and
# set VITE_TUTOR_PROXY_URL below. See SECURITY.md.
# ─────────────────────────────────────────────────────────────

# RECOMMENDED (production): URL of a server-side proxy that holds the
# real key and grounds answers. The browser calls this WITHOUT any secret.
VITE_TUTOR_PROXY_URL=

# LOCAL DEV ONLY — direct Azure call. The key below WILL be exposed if
# you deploy a build with it set. Use only on your own machine.
VITE_AZURE_OPENAI_ENDPOINT=
VITE_AZURE_OPENAI_KEY=
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Microsoft Foundry IQ (knowledge base / grounding) — fill in when provisioned.
# These belong on the SERVER side once the proxy exists, not in VITE_ vars.
VITE_FOUNDRY_PROJECT_ENDPOINT=
VITE_FOUNDRY_KNOWLEDGE_BASE_ID=
